{
  "name": "open-latex-studio",
  "displayName": "Open LaTeX Studio",
  "description": "LaTeX writing studio: compile with Tectonic, preview the PDF, jump between source and PDF, and verify citations with bundled Research Assistant MCP.",
  "version": "0.1.0",
  "publisher": "open-latex-studio",
  "icon": "assets/icon.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevieTheTurtle/open-latex-studio.git"
  },
  "bugs": {
    "url": "https://github.com/stevieTheTurtle/open-latex-studio/issues"
  },
  "homepage": "https://github.com/stevieTheTurtle/open-latex-studio#readme",
  "keywords": [
    "latex",
    "tectonic",
    "synctex",
    "pdf"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex",
    "onCommand:openLatexStudio.researchAssistant.setup",
    "onCommand:openLatexStudio.researchAssistant.status",
    "onCommand:openLatexStudio.researchAssistant.syncZotero",
    "onCommand:openLatexStudio.researchAssistant.openWebUi",
    "onCommand:openLatexStudio.researchAssistant.registerClients",
    "onCommand:openLatexStudio.researchAssistant.installWorkspaceSkill"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PDFs can be viewed, but compiling and Research Assistant scripts need a trusted workspace.",
      "restrictedConfigurations": [
        "openLatexStudio.tectonicPath",
        "openLatexStudio.outDir",
        "openLatexStudio.copyPdfTo",
        "openLatexStudio.citations.statusCommand",
        "openLatexStudio.researchAssistant.installDir",
        "openLatexStudio.researchAssistant.pythonPath",
        "openLatexStudio.researchAssistant.dataDir",
        "openLatexStudio.researchAssistant.zoteroDir"
      ]
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "openLatexStudio.researchAssistant",
        "label": "Open LaTeX Studio — Research Assistant"
      }
    ],
    "customEditors": [
      {
        "viewType": "openLatexStudio.pdf",
        "displayName": "Open LaTeX Studio PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "openLatexStudio.compile",
        "title": "Compile",
        "category": "Open LaTeX Studio",
        "icon": "$(play)"
      },
      {
        "command": "openLatexStudio.compileClean",
        "title": "Clean and Compile",
        "category": "Open LaTeX Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "openLatexStudio.openPreview",
        "title": "Open PDF Preview",
        "category": "Open LaTeX Studio",
        "icon": "$(open-preview)"
      },
      {
        "command": "openLatexStudio.syncToPdf",
        "title": "Go to Location in PDF",
        "category": "Open LaTeX Studio",
        "icon": "$(arrow-right)"
      },
      {
        "command": "openLatexStudio.syncToCode",
        "title": "Go to Location in Source",
        "category": "Open LaTeX Studio",
        "icon": "$(arrow-left)"
      },
      {
        "command": "openLatexStudio.showLog",
        "title": "Show Compiler Log",
        "category": "Open LaTeX Studio",
        "icon": "$(output)"
      },
      {
        "command": "openLatexStudio.wordCount",
        "title": "Word Count",
        "category": "Open LaTeX Studio",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "openLatexStudio.refreshCitationStatus",
        "title": "Refresh Citation Status",
        "category": "Open LaTeX Studio",
        "icon": "$(verified)"
      },
      {
        "command": "openLatexStudio.researchAssistant.setup",
        "title": "Research Assistant: Set Up / Configure",
        "category": "Open LaTeX Studio",
        "icon": "$(tools)"
      },
      {
        "command": "openLatexStudio.researchAssistant.status",
        "title": "Research Assistant: Status & Actions",
        "category": "Open LaTeX Studio",
        "icon": "$(library)"
      },
      {
        "command": "openLatexStudio.researchAssistant.syncZotero",
        "title": "Research Assistant: Sync Zotero Library",
        "category": "Open LaTeX Studio",
        "icon": "$(sync)"
      },
      {
        "command": "openLatexStudio.researchAssistant.openWebUi",
        "title": "Research Assistant: Open Web UI",
        "category": "Open LaTeX Studio",
        "icon": "$(globe)"
      },
      {
        "command": "openLatexStudio.researchAssistant.registerClients",
        "title": "Research Assistant: Register MCP & Skills",
        "category": "Open LaTeX Studio",
        "icon": "$(plug)"
      },
      {
        "command": "openLatexStudio.researchAssistant.installWorkspaceSkill",
        "title": "Research Assistant: Install Citation Rules in Workspace",
        "category": "Open LaTeX Studio",
        "icon": "$(file-add)"
      },
      {
        "command": "openLatexStudio.insert.bold",
        "title": "Bold",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.italic",
        "title": "Italic",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.math",
        "title": "Inline Math",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.cite",
        "title": "Citation",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.ref",
        "title": "Cross-Reference",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.figure",
        "title": "Figure",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.table",
        "title": "Table",
        "category": "Open LaTeX Studio"
      },
      {
        "command": "openLatexStudio.insert.itemize",
        "title": "Bulleted List",
        "category": "Open LaTeX Studio"
      }
    ],
    "submenus": [
      {
        "id": "openLatexStudio.insertMenu",
        "label": "Insert LaTeX",
        "icon": "$(symbol-snippet)"
      },
      {
        "id": "openLatexStudio.researchMenu",
        "label": "Research Assistant",
        "icon": "$(library)"
      }
    ],
    "menus": {
      "openLatexStudio.insertMenu": [
        { "command": "openLatexStudio.insert.bold", "group": "1_text@1" },
        { "command": "openLatexStudio.insert.italic", "group": "1_text@2" },
        { "command": "openLatexStudio.insert.math", "group": "1_text@3" },
        { "command": "openLatexStudio.insert.cite", "group": "2_refs@1" },
        { "command": "openLatexStudio.insert.ref", "group": "2_refs@2" },
        { "command": "openLatexStudio.insert.figure", "group": "3_blocks@1" },
        { "command": "openLatexStudio.insert.table", "group": "3_blocks@2" },
        { "command": "openLatexStudio.insert.itemize", "group": "3_blocks@3" }
      ],
      "openLatexStudio.researchMenu": [
        { "command": "openLatexStudio.researchAssistant.status", "group": "1_status@1" },
        { "command": "openLatexStudio.researchAssistant.syncZotero", "group": "2_actions@1" },
        { "command": "openLatexStudio.refreshCitationStatus", "group": "2_actions@2" },
        { "command": "openLatexStudio.researchAssistant.openWebUi", "group": "2_actions@3" },
        { "command": "openLatexStudio.researchAssistant.setup", "group": "3_setup@1" },
        { "command": "openLatexStudio.researchAssistant.registerClients", "group": "3_setup@2" },
        { "command": "openLatexStudio.researchAssistant.installWorkspaceSkill", "group": "3_setup@3" }
      ],
      "editor/title": [
        {
          "submenu": "openLatexStudio.insertMenu",
          "when": "editorLangId == latex",
          "group": "navigation@4"
        },
        {
          "submenu": "openLatexStudio.researchMenu",
          "when": "editorLangId == latex",
          "group": "navigation@5"
        },
        {
          "command": "openLatexStudio.compile",
          "when": "editorLangId == latex",
          "group": "navigation@1"
        },
        {
          "command": "openLatexStudio.openPreview",
          "when": "editorLangId == latex",
          "group": "navigation@2"
        },
        {
          "command": "openLatexStudio.syncToPdf",
          "when": "editorLangId == latex",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openLatexStudio.insert.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == latex && config.openLatexStudio.formatKeybindings"
      },
      {
        "command": "openLatexStudio.insert.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == latex && config.openLatexStudio.formatKeybindings"
      },
      {
        "command": "openLatexStudio.compile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == latex || activeCustomEditorId == openLatexStudio.pdf"
      },
      {
        "command": "openLatexStudio.syncToPdf",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "openLatexStudio.syncToCode",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeCustomEditorId == openLatexStudio.pdf"
      }
    ],
    "configuration": {
      "title": "Open LaTeX Studio",
      "properties": {
        "openLatexStudio.languageFeatures.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Provide citation, reference and environment completion and the outline. Turn this off if another LaTeX extension already does."
        },
        "openLatexStudio.formatKeybindings": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Use `Ctrl+B` and `Ctrl+I` for bold and italic in LaTeX files. These replace the sidebar toggle and inline chat shortcuts while a LaTeX file has focus."
        },
        "openLatexStudio.mainFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Document to compile, relative to the workspace folder. Leave empty to use `% !TEX root`, the open document, or a search of the workspace."
        },
        "openLatexStudio.outDir": {
          "type": "string",
          "default": ".latex-studio/build",
          "scope": "resource",
          "markdownDescription": "Folder for the PDF and SyncTeX files, relative to the workspace folder."
        },
        "openLatexStudio.copyPdfTo": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "After a successful build, also copy the PDF to this path, relative to the workspace folder."
        },
        "openLatexStudio.tectonicPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Tectonic executable. Leave empty to find it on `PATH`."
        },
        "openLatexStudio.compile.trigger": {
          "type": "string",
          "enum": [
            "save",
            "typing",
            "off"
          ],
          "enumDescriptions": [
            "Compile whenever a LaTeX file is saved.",
            "Save and compile a moment after you stop typing.",
            "Compile only on request."
          ],
          "default": "save",
          "scope": "resource",
          "markdownDescription": "When to compile automatically."
        },
        "openLatexStudio.compile.typingDelayMs": {
          "type": "number",
          "default": 2800,
          "minimum": 500,
          "scope": "resource",
          "markdownDescription": "How long to wait after the last keystroke when `#openLatexStudio.compile.trigger#` is `typing`."
        },
        "openLatexStudio.citations.notesFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a citation evidence notes JSON file (e.g. `01_Thesis_meta/references.notes.json`), relative to the workspace folder. Sibling `<bib>.notes.json` files are also loaded automatically."
        },
        "openLatexStudio.citations.statusFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a citation status JSON file (defaults to `<outDir>/citation_status.json`), relative to the workspace folder."
        },
        "openLatexStudio.citations.statusCommand": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Optional custom shell command run in the background (in trusted workspaces) to refresh the citation status JSON file. Leave empty to use the bundled Research Assistant bridge automatically."
        },
        "openLatexStudio.researchAssistant.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Enable the bundled Research Assistant citation status checker, MCP provider, and Zotero sync."
        },
        "openLatexStudio.researchAssistant.installDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Stable directory for the Research Assistant Python source, `.venv`, and `config.yaml`. Leave empty to use `~/.open-latex-studio/research-assistant`."
        },
        "openLatexStudio.researchAssistant.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Optional Python 3.10+ executable override used for citation checks and initial setup."
        },
        "openLatexStudio.researchAssistant.dataDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Directory containing Research Assistant's `collections/` and `metadata.db` (e.g. a OneDrive-synced folder). Leave empty to auto-detect or use `<installDir>/data`."
        },
        "openLatexStudio.researchAssistant.collection": {
          "type": "string",
          "default": "Zotero",
          "scope": "resource",
          "markdownDescription": "Research Assistant collection name used for citation verification and Zotero sync."
        },
        "openLatexStudio.researchAssistant.zoteroDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Zotero data folder containing `zotero.sqlite`. Leave empty to auto-detect."
        },
        "openLatexStudio.researchAssistant.zoteroSyncIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "If greater than 0, automatically runs incremental Zotero sync in the background every N minutes (e.g. `30`)."
        },
        "openLatexStudio.researchAssistant.webUiPort": {
          "type": "number",
          "default": 8000,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "window",
          "markdownDescription": "Local port for the Research Assistant Web UI."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:modern": "node build.mjs modern",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning test/unit/parsers.test.ts test/unit/compile.test.ts test/unit/latex.test.ts test/unit/citations.test.ts test/unit/researchAssistant.test.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.99.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
