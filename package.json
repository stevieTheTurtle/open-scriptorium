{
  "name": "open-scriptorium",
  "displayName": "Open Scriptorium",
  "description": "FOSS academic research & writing studio uniting AI agents, Zotero, and a bundled local LaTeX studio for VS Code & Antigravity.",
  "version": "0.4.1",
  "publisher": "stevieTheTurtle",
  "author": {
    "name": "Stefano Calzolari",
    "url": "https://github.com/stevieTheTurtle"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#4f141e",
    "theme": "dark"
  },
  "qna": "https://github.com/stevieTheTurtle/open-scriptorium/issues",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevieTheTurtle/open-scriptorium.git"
  },
  "bugs": {
    "url": "https://github.com/stevieTheTurtle/open-scriptorium/issues"
  },
  "homepage": "https://github.com/stevieTheTurtle/open-scriptorium#readme",
  "keywords": [
    "latex",
    "tectonic",
    "synctex",
    "pdf",
    "zotero",
    "bibtex",
    "citations",
    "research-assistant",
    "mcp",
    "rag",
    "antigravity"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex",
    "onCommand:openScriptorium.installTectonic",
    "onCommand:openScriptorium.findSupportingCitation",
    "onCommand:openScriptorium.researchAssistant.setup",
    "onCommand:openScriptorium.researchAssistant.status",
    "onCommand:openScriptorium.researchAssistant.syncZotero",
    "onCommand:openScriptorium.researchAssistant.openWebUi",
    "onCommand:openScriptorium.researchAssistant.registerClients",
    "onCommand:openScriptorium.researchAssistant.installWorkspaceSkill"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PDFs can be viewed, but compiling and Research Assistant scripts need a trusted workspace.",
      "restrictedConfigurations": [
        "openScriptorium.tectonicPath",
        "openScriptorium.outDir",
        "openScriptorium.copyPdfTo",
        "openScriptorium.citations.statusCommand",
        "openScriptorium.researchAssistant.installDir",
        "openScriptorium.researchAssistant.pythonPath",
        "openScriptorium.researchAssistant.dataDir",
        "openScriptorium.researchAssistant.zoteroDir"
      ]
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "openScriptorium.researchAssistant",
        "label": "Open Scriptorium — Research Assistant"
      }
    ],
    "customEditors": [
      {
        "viewType": "openScriptorium.pdf",
        "displayName": "Open Scriptorium PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "openScriptorium.compile",
        "title": "Compile",
        "category": "Open Scriptorium",
        "icon": "$(play)"
      },
      {
        "command": "openScriptorium.compileClean",
        "title": "Clean and Compile",
        "category": "Open Scriptorium",
        "icon": "$(clear-all)"
      },
      {
        "command": "openScriptorium.installTectonic",
        "title": "Install / Update Tectonic",
        "category": "Open Scriptorium",
        "icon": "$(cloud-download)"
      },
      {
        "command": "openScriptorium.openPreview",
        "title": "Open PDF Preview",
        "category": "Open Scriptorium",
        "icon": "$(open-preview)"
      },
      {
        "command": "openScriptorium.syncToPdf",
        "title": "Go to Location in PDF",
        "category": "Open Scriptorium",
        "icon": "$(arrow-right)"
      },
      {
        "command": "openScriptorium.syncToCode",
        "title": "Go to Location in Source",
        "category": "Open Scriptorium",
        "icon": "$(arrow-left)"
      },
      {
        "command": "openScriptorium.showLog",
        "title": "Show Compiler Log",
        "category": "Open Scriptorium",
        "icon": "$(output)"
      },
      {
        "command": "openScriptorium.wordCount",
        "title": "Word Count",
        "category": "Open Scriptorium",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "openScriptorium.refreshCitationStatus",
        "title": "Refresh Citation Status",
        "category": "Open Scriptorium",
        "icon": "$(verified)"
      },
      {
        "command": "openScriptorium.findSupportingCitation",
        "title": "Find Supporting Citation in Zotero",
        "category": "Open Scriptorium",
        "icon": "$(search)"
      },
      {
        "command": "openScriptorium.researchAssistant.setup",
        "title": "Research Assistant: Set Up / Configure",
        "category": "Open Scriptorium",
        "icon": "$(tools)"
      },
      {
        "command": "openScriptorium.researchAssistant.status",
        "title": "Research Assistant: Status & Actions",
        "category": "Open Scriptorium",
        "icon": "$(library)"
      },
      {
        "command": "openScriptorium.researchAssistant.syncZotero",
        "title": "Research Assistant: Sync Zotero Library",
        "category": "Open Scriptorium",
        "icon": "$(sync)"
      },
      {
        "command": "openScriptorium.researchAssistant.openWebUi",
        "title": "Research Assistant: Open Web UI",
        "category": "Open Scriptorium",
        "icon": "$(globe)"
      },
      {
        "command": "openScriptorium.researchAssistant.registerClients",
        "title": "Research Assistant: Register MCP & Skills",
        "category": "Open Scriptorium",
        "icon": "$(plug)"
      },
      {
        "command": "openScriptorium.researchAssistant.installWorkspaceSkill",
        "title": "Research Assistant: Install Citation Rules in Workspace",
        "category": "Open Scriptorium",
        "icon": "$(file-add)"
      },
      {
        "command": "openScriptorium.insert.bold",
        "title": "Bold",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.italic",
        "title": "Italic",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.math",
        "title": "Inline Math",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.cite",
        "title": "Citation",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.ref",
        "title": "Cross-Reference",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.figure",
        "title": "Figure",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.table",
        "title": "Table",
        "category": "Open Scriptorium"
      },
      {
        "command": "openScriptorium.insert.itemize",
        "title": "Bulleted List",
        "category": "Open Scriptorium"
      }
    ],
    "submenus": [
      {
        "id": "openScriptorium.insertMenu",
        "label": "Insert LaTeX",
        "icon": "$(symbol-snippet)"
      },
      {
        "id": "openScriptorium.researchMenu",
        "label": "Research Assistant",
        "icon": "$(library)"
      }
    ],
    "menus": {
      "openScriptorium.insertMenu": [
        { "command": "openScriptorium.insert.bold", "group": "1_text@1" },
        { "command": "openScriptorium.insert.italic", "group": "1_text@2" },
        { "command": "openScriptorium.insert.math", "group": "1_text@3" },
        { "command": "openScriptorium.insert.cite", "group": "2_refs@1" },
        { "command": "openScriptorium.insert.ref", "group": "2_refs@2" },
        { "command": "openScriptorium.insert.figure", "group": "3_blocks@1" },
        { "command": "openScriptorium.insert.table", "group": "3_blocks@2" },
        { "command": "openScriptorium.insert.itemize", "group": "3_blocks@3" }
      ],
      "openScriptorium.researchMenu": [
        { "command": "openScriptorium.researchAssistant.status", "group": "1_status@1" },
        { "command": "openScriptorium.findSupportingCitation", "group": "2_actions@0" },
        { "command": "openScriptorium.researchAssistant.syncZotero", "group": "2_actions@1" },
        { "command": "openScriptorium.refreshCitationStatus", "group": "2_actions@2" },
        { "command": "openScriptorium.researchAssistant.openWebUi", "group": "2_actions@3" },
        { "command": "openScriptorium.researchAssistant.setup", "group": "3_setup@1" },
        { "command": "openScriptorium.researchAssistant.registerClients", "group": "3_setup@2" },
        { "command": "openScriptorium.researchAssistant.installWorkspaceSkill", "group": "3_setup@3" }
      ],
      "editor/context": [
        {
          "command": "openScriptorium.findSupportingCitation",
          "when": "editorLangId == latex",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "submenu": "openScriptorium.insertMenu",
          "when": "editorLangId == latex",
          "group": "navigation@4"
        },
        {
          "submenu": "openScriptorium.researchMenu",
          "when": "editorLangId == latex",
          "group": "navigation@5"
        },
        {
          "command": "openScriptorium.compile",
          "when": "editorLangId == latex",
          "group": "navigation@1"
        },
        {
          "command": "openScriptorium.openPreview",
          "when": "editorLangId == latex",
          "group": "navigation@2"
        },
        {
          "command": "openScriptorium.syncToPdf",
          "when": "editorLangId == latex",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openScriptorium.insert.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == latex && config.openScriptorium.formatKeybindings"
      },
      {
        "command": "openScriptorium.insert.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == latex && config.openScriptorium.formatKeybindings"
      },
      {
        "command": "openScriptorium.compile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == latex || activeCustomEditorId == openScriptorium.pdf"
      },
      {
        "command": "openScriptorium.syncToPdf",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "openScriptorium.syncToCode",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeCustomEditorId == openScriptorium.pdf"
      },
      {
        "command": "openScriptorium.findSupportingCitation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId == latex || activeCustomEditorId == openScriptorium.pdf"
      }
    ],
    "configuration": {
      "title": "Open Scriptorium",
      "properties": {
        "openScriptorium.languageFeatures.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Provide citation, reference and environment completion and the outline. Turn this off if another LaTeX extension already does."
        },
        "openScriptorium.formatKeybindings": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Use `Ctrl+B` and `Ctrl+I` for bold and italic in LaTeX files. These replace the sidebar toggle and inline chat shortcuts while a LaTeX file has focus."
        },
        "openScriptorium.mainFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Document to compile, relative to the workspace folder. Leave empty to use `% !TEX root`, the open document, or a search of the workspace."
        },
        "openScriptorium.outDir": {
          "type": "string",
          "default": ".scriptorium/build",
          "scope": "resource",
          "markdownDescription": "Folder for the PDF and SyncTeX files, relative to the workspace folder."
        },
        "openScriptorium.copyPdfTo": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "After a successful build, also copy the PDF to this path, relative to the workspace folder."
        },
        "openScriptorium.tectonicPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Tectonic executable. Leave empty to use `tectonic` on `PATH` or the managed copy in `~/.open-scriptorium/bin/` (auto-installed on first compile)."
        },
        "openScriptorium.tectonic.autoInstall": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "Automatically download and install a managed Tectonic binary into `~/.open-scriptorium/bin/` on first compile when `tectonicPath` is empty and Tectonic is not on `PATH`."
        },
        "openScriptorium.compile.trigger": {
          "type": "string",
          "enum": [
            "save",
            "typing",
            "off"
          ],
          "enumDescriptions": [
            "Compile whenever a LaTeX file is saved.",
            "Save and compile a moment after you stop typing.",
            "Compile only on request."
          ],
          "default": "save",
          "scope": "resource",
          "markdownDescription": "When to compile automatically."
        },
        "openScriptorium.compile.typingDelayMs": {
          "type": "number",
          "default": 2800,
          "minimum": 500,
          "scope": "resource",
          "markdownDescription": "How long to wait after the last keystroke when `#openScriptorium.compile.trigger#` is `typing`."
        },
        "openScriptorium.citations.notesFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a citation evidence notes JSON file (e.g. `01_Thesis_meta/references.notes.json`), relative to the workspace folder. Sibling `<bib>.notes.json` files are also loaded automatically."
        },
        "openScriptorium.citations.statusFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a citation status JSON file (defaults to `<outDir>/citation_status.json`), relative to the workspace folder."
        },
        "openScriptorium.citations.statusCommand": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Optional custom shell command run in the background (in trusted workspaces) to refresh the citation status JSON file. Leave empty to use the bundled Research Assistant bridge automatically."
        },
        "openScriptorium.citations.citeCommand": {
          "type": "string",
          "enum": [
            "\\cite",
            "\\citep",
            "\\citet",
            "\\parencite",
            "\\textcite",
            "\\autocite"
          ],
          "default": "\\cite",
          "scope": "resource",
          "markdownDescription": "Default LaTeX citation command inserted by **Find Supporting Citation in Zotero**."
        },
        "openScriptorium.researchAssistant.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Enable the bundled Research Assistant citation status checker, MCP provider, and Zotero sync."
        },
        "openScriptorium.researchAssistant.installDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Stable directory for the Research Assistant Python source, `.venv`, and `config.yaml`. Leave empty to use `~/.open-scriptorium/research-assistant`."
        },
        "openScriptorium.researchAssistant.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Optional Python 3.10+ executable override used for citation checks and initial setup."
        },
        "openScriptorium.researchAssistant.dataDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Directory containing Research Assistant's `collections/` and `metadata.db` (e.g. a OneDrive-synced folder). Leave empty to auto-detect or use `<installDir>/data`."
        },
        "openScriptorium.researchAssistant.collection": {
          "type": "string",
          "default": "Zotero",
          "scope": "resource",
          "markdownDescription": "Research Assistant collection name used for citation verification and Zotero sync."
        },
        "openScriptorium.researchAssistant.zoteroDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Zotero data folder containing `zotero.sqlite`. Leave empty to auto-detect."
        },
        "openScriptorium.researchAssistant.zoteroSyncIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "If greater than 0, automatically runs incremental Zotero sync in the background every N minutes (e.g. `30`)."
        },
        "openScriptorium.researchAssistant.webUiPort": {
          "type": "number",
          "default": 8000,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "window",
          "markdownDescription": "Local port for the Research Assistant Web UI and warm CLI daemon."
        },
        "openScriptorium.researchAssistant.mcpFallback": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Also register the stdio Research Assistant MCP server (opt-in fallback for clients without shell access). When false, Open Scriptorium configures the lower-token `ra` CLI only."
        },
        "openScriptorium.researchAssistant.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Keep the local Research Assistant HTTP service warm in the background while a LaTeX workspace is open so `ra` CLI searches respond in ~50 ms and the Web UI opens immediately."
        },
        "openScriptorium.researchAssistant.rerankerModel": {
          "type": "string",
          "default": "cross-encoder/ms-marco-MiniLM-L-6-v2",
          "scope": "machine-overridable",
          "markdownDescription": "Local `sentence-transformers` CrossEncoder model used by **Find Supporting Citation in Zotero** (e.g. `cross-encoder/ms-marco-MiniLM-L-6-v2`, `BAAI/bge-reranker-base`, or `cross-encoder/nli-deberta-v3-small`)."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:modern": "node build.mjs modern",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning test/unit/parsers.test.ts test/unit/compile.test.ts test/unit/tectonicInstaller.test.ts test/unit/latex.test.ts test/unit/citations.test.ts test/unit/citationFinder.test.ts test/unit/researchAssistant.test.ts",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "publish:vscode": "npx --yes @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npx --yes ovsx publish --no-dependencies"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.99.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
